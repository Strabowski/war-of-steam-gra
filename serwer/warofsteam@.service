# Kolejne bitwy War of Steam na tym samym komputerze (KAN-206): warofsteam@2, @3, @4 – każda z własną
# konfiguracją /etc/warofsteam/serwer-N.cfg (port, numer, nazwa). Bitwa 1 to usługa warofsteam.
# Włącza i wyłącza je polecenie: sudo warofsteam-bitwy N
[Unit]
Description=War of Steam – bitwa %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warofsteam
Group=warofsteam
WorkingDirectory=/var/lib/warofsteam
ExecStart=/opt/warofsteam/godot/godot --headless --main-pack /opt/warofsteam/gra/aktualna.pck res://server/serwer.tscn -- --config=/etc/warofsteam/serwer-%i.cfg
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/warofsteam
ReadOnlyPaths=/opt/warofsteam /etc/warofsteam

[Install]
WantedBy=multi-user.target
